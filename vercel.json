{
  "rewrites": [
    { "source": "/us/:slug", "destination": "/us/:slug/index.html" },
    { "source": "/uk/:slug", "destination": "/uk/:slug/index.html" },
    { "source": "/ca/:slug", "destination": "/ca/:slug/index.html" },
    { "source": "/au/:slug", "destination": "/au/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
